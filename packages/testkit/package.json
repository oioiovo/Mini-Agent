{
  "name": "@mini-agent/testkit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "mini-agent-testkit": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "cases", "hooks"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "tsx src/cli.ts",
    "test": "tsx src/cli.ts --mode unit,e2e",
    "test:unit": "tsx src/cli.ts --mode unit",
    "test:e2e": "tsx src/cli.ts --mode e2e",
    "test:live": "tsx src/cli.ts --mode live"
  },
  "dependencies": {
    "@mini-agent/runtime": "workspace:*",
    "@mini-agent/sdk": "workspace:*",
    "@mini-agent/server": "workspace:*",
    "dotenv": "^17.4.2",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
