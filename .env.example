MINI_AGENT_PORT=8787
MINI_AGENT_API_KEY=dev-key
OPENAI_API_KEY=
# OpenAI-compatible endpoint (must include /v1 if the provider uses it)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# DeepSeek example:
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# OPENAI_MODEL=deepseek-chat
MINI_AGENT_DATA_DIR=./data
MINI_AGENT_WORKSPACE=./workspace
# Auto-approve write/network tools (local debug only)
MINI_AGENT_AUTO_APPROVE=false
# Allow http_request to private/LAN hosts
MINI_AGENT_HTTP_ALLOW_PRIVATE=false
# Example client auto-approves tool.approval_required events
MINI_AGENT_EXAMPLE_AUTO_APPROVE=true
